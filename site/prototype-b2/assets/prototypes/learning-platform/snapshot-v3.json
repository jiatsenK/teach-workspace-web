e":"文法","label":"-아요/어요/여요","explanation":"日常會話常用的禮貌句尾。詞幹最後母音是 ㅏ／ㅗ 時接 -아요，其他母音接 -어요；하다 類可由 하여요 縮約成 해요。","sourceRange":"p.81"},{"id":"CONTENT-0002","type":"句型","label":"무엇을 해요?","explanation":"詢問「做什麼？」的基本句型，回答可直接使用日常活動動詞的 -아요/어요 形式。","sourceRange":"p.80"},{"id":"CONTENT-0003","type":"句型","label":"V-아요/어요?","explanation":"用已活用的動詞直接提出日常活動的是非問句；肯定可用「네」，否定可用「아니요」後改說實際進行的活動。","sourceRange":"p.80–82"},{"id":"CONTENT-0004","type":"文法","label":"하고","explanation":"接在人或名詞後，表示「和……一起／跟……」。","sourceRange":"p.82"},{"id":"CONTENT-0005","type":"學習情境","label":"일상생활 활동","explanation":"本段以日常生活活動為主題，練習閱讀、看電視、吃喝、聽音樂、購物、運動、和朋友互動等表達。","sourceRange":"p.80–82"}],"vocabulary":[{"id":"VOC-0001","word":"살다","meaning":"居住、生活","form":"살아요","memoryStatus":"待複習","sourceRange":"p.81"},{"id":"VOC-0002","word":"놀다","meaning":"玩、遊玩","form":"놀아요","memoryStatus":"待複習","sourceRange":"p.81"},{"id":"VOC-0003","word":"먹다","meaning":"吃","form":"먹어요","memoryStatus":"待複習","sourceRange":"p.80–82"},{"id":"VOC-0004","word":"읽다","meaning":"讀、閱讀","form":"읽어요","memoryStatus":"待複習","sourceRange":"p.80–82"},{"id":"VOC-0005","word":"보다","meaning":"看","form":"봐요","memoryStatus":"待複習","sourceRange":"p.81–82"},{"id":"VOC-0006","word":"만나다","meaning":"見面、遇見","form":"만나요","memoryStatus":"待複習","sourceRange":"p.80–81"},{"id":"VOC-0007","word":"말하다","meaning":"說、說話","form":"말해요","memoryStatus":"待複習","sourceRange":"p.81"},{"id":"VOC-0008","word":"가다","meaning":"去","form":"가요","memoryStatus":"待複習","sourceRange":"p.81"},{"id":"VOC-0009","word":"오다","meaning":"來","form":"와요","memoryStatus":"待複習","sourceRange":"p.81"},{"id":"VOC-0010","word":"쉬다","meaning":"休息","form":"쉬어요","memoryStatus":"待複習","sourceRange":"p.81"},{"id":"VOC-0011","word":"듣다","meaning":"聽","form":"들어요","memoryStatus":"待複習","sourceRange":"p.80–82"},{"id":"VOC-0012","word":"마시다","meaning":"喝","form":"마셔요","memoryStatus":"待複習","sourceRange":"p.81–82"},{"id":"VOC-0013","word":"공부하다","meaning":"學習、念書","form":"공부해요","memoryStatus":"待複習","sourceRange":"p.81"},{"id":"VOC-